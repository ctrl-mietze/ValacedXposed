<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.discord" />
        <package android:name="com.music.bitchord" />
        <package android:name="com.spotify.music" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <package android:name="app.morphe.android.youtube" />
        <package android:name="app.morphe.android.apps.youtube.music" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_valancedx"
        android:supportsRtl="true">
        <activity
            android:name="app.valenced.xposed.manager.ValancedXActivity"
            android:label="@string/app_name"
            android:theme="@style/ValancedXTheme"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name="app.valenced.xposed.manager.analysis.PluginSandboxService"
            android:isolatedProcess="true"
            android:process=":plugin_sandbox"
            android:exported="false" />
        <provider
            android:name="app.valenced.xposed.manager.SettingsProvider"
            android:authorities="${applicationId}.settings"
            android:exported="true">
            <grant-uri-permission android:path="/connection" />
        </provider>
        <meta-data android:name="xposedmodule" android:value="true"/>
        <meta-data android:name="xposeddescription" android:resource="@string/xposed_description"/>
        <meta-data android:name="xposedminversion" android:value="82"/>
        <meta-data android:name="xposedscope" android:value="com.discord;com.music.bitchord;com.spotify.music;com.aspiro.tidal;com.google.android.apps.youtube.music;com.google.android.youtube;app.morphe.android.youtube;app.morphe.android.apps.youtube.music"/>
    </application>
</manifest>
